generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "cockroachdb"
}

model Profile {
  id          String @id @default(uuid())
  name        String
  description String

  links      ProfessionalLink[]
  skills     Skill[]
  experience Experience[]
  projects   Project[]
}

model ProfessionalLink {
  id        String @id @default(uuid())
  label     String
  url       String
  sortOrder Int
  profileId String

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Skill {
  id        String @id @default(uuid())
  name      String
  sortOrder Int
  profileId String

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Experience {
  id        String    @id @default(uuid())
  company   String
  position  String
  startDate DateTime
  endDate   DateTime?
  profileId String

  profile      Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  achievements Achievement[]
}

model Achievement {
  id           String @id @default(uuid())
  description  String
  sortOrder    Int
  experienceId String

  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
}

model Project {
  id        String @id @default(uuid())
  name      String
  url       String
  sortOrder Int
  profileId String

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}